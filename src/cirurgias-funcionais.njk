    sinusite.style.display = "none";
    adenoamigda.style.display = "none";

    desvioButton.classList.remove("active");
    amigdalaButton.classList.remove("active");
    reducaoButton.classList.remove("active");
    tubinectomiaButton.classList.remove("active");
    uvuloButton.classList.remove("active");
    adenoideButton.classList.remove("active");
    sinusiteButton.classList.remove("active");
    adenoamigdaButton.classList.remove("active");

    switch (id) {
      case "desvio":
        desvio.style.display = "flex";
        desvioButton.classList.add("active");
        break;
      case "amigdala":
        amigdala.style.display = "flex";
        amigdalaButton.classList.add("active");
        break;
      case "reducao":
