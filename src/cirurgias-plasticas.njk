<script>
  const rinoButton = document.getElementById(`rinoplastiaButton`);
  const otoplastiaButton = document.getElementById(`otoplastiaButton`);
  const blefaroButton = document.getElementById(`blefaroplastiaButton`);

  const rinoplastia = document.getElementById(`rinoplastia`);
  const otoplastia = document.getElementById(`otoplastia`);
  const blefaroplastia = document.getElementById(`blefaroplastia`);

  function pickTab(id) {
    rinoplastia.style.display = "none";
    otoplastia.style.display = "none";
    blefaroplastia.style.display = "none";

    rinoButton.classList.remove("active");
    otoplastiaButton.classList.remove("active");
    blefaroButton.classList.remove("active");

    switch (id) {
      case "rinoplastia":
        rinoplastia.style.display = "flex";
        rinoButton.classList.add("active");
        break;
      case "otoplastia":
        otoplastia.style.display = "flex";
        otoplastiaButton.classList.add("active");
        break;
      case "blefaroplastia":
        blefaroplastia.style.display = "flex";
        blefaroButton.classList.add("active");
        break;
      default:
        break;
    }
  }

  const swiper = new Swiper(".swiper", {
    // Optional parameters
    direction: "horizontal",
    slidesPerView: "1",
    spaceBetween: 50,

    // If we need pagination
    pagination: {
      el: ".swiper-pagination",
    },

    // Navigation arrows
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },

    // And if we need scrollbar
    scrollbar: {
      el: ".swiper-scrollbar",
    },
  });

  var coll = document.getElementsByClassName("collapsible");
  var i;

  for (i = 0; i < coll.length; i++) {
    coll[i].addEventListener("click", function () {
      this.classList.toggle("active");
      var el = this.children;
      if (this.classList[1]) {
        el[0].innerText = "-";
      } else {
        el[0].innerText = "+";
      }

      var content = this.nextElementSibling;
      if (content.style.display === "block") {
        content.style.display = "none";
      } else {
        content.style.display = "block";
      }
    });
  }

  const swiper2 = new Swiper(".swiper", {
    // Optional parameters
    direction: "horizontal",
    slidesPerView: "1",
